# APP_NAME=Dahua Access API
# DEBUG=true
# LOG_LEVEL=INFO

# # Auth: JWT signing secret. Generate strong:
# #   python -c "import secrets; print(secrets.token_urlsafe(32))"
# JWT_SECRET=change-me-please-use-a-long-random-string
# JWT_EXPIRE_MINUTES=60

# # Admin user (login). Password is BCRYPT-HASHED. Hash a new one with:
# #   python -m scripts.hash_password
# # Default below is the hash for "admin1234" — CHANGE in production!
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD_HASH=$2b$12$KIXxDTzqB5L4qB0YUVxAFOQqz0oQjhAH2Lv1L5/gmFx7WAXmFM.6m

# # API key (alternative to JWT, for service-to-service)
# API_KEY=change-me-too

# # CORS
# ALLOWED_ORIGINS=*

# # Rate limit (per IP)
# RATE_LIMIT_DEFAULT=60/minute
# RATE_LIMIT_AUTH=10/minute
# RATE_LIMIT_WRITE=20/minute

# # Database
# DATABASE_URL=sqlite:///data/jobs.sqlite

# # Devices
# DEVICES=[{"name":"host","ip":"10.10.20.41","port":37777,"username":"admin","password":"admin1234"},{"name":"recv","ip":"10.10.20.78","port":37777,"username":"admin","password":"admin1234"}]
